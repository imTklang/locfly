// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  MOVIDA
  LOCALIZA
  UNIDAS
  FOCO
  HERTZ
  OTHER
}

enum Category {
  ECONOMICO
  INTERMEDIARIO
  SUV
  LUXO
  VAN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  priceAlerts   PriceAlert[]
  bookmarks     Bookmark[]
}

model SearchCache {
  id            String    @id @default(uuid())
  location      String
  startDate     DateTime
  endDate       DateTime
  results       Json      // Armazena a lista de ofertas encontradas
  updatedAt     DateTime  @updatedAt

  @@index([location, startDate, endDate])
}

model PriceAlert {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  location      String
  targetPrice   Decimal
  carCategory   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Bookmark {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  carOfferId    String
  carOffer      CarOffer  @relation(fields: [carOfferId], references: [id])
  createdAt     DateTime  @default(now())

  @@unique([userId, carOfferId])
}

model CarOffer {
  id            String    @id @default(uuid())
  provider      Provider  @default(OTHER)
  model         String
  category      Category  @default(ECONOMICO)
  price         Decimal
  transmission  String?
  hasAC         Boolean?
  seats         Int?
  deepLink      String
  imageUrl      String?
  createdAt     DateTime  @default(now())
  bookmarks     Bookmark[]
}
