# Server
PORT=4000
NODE_ENV=development

# Database — PostgreSQL (running via docker-compose)
DATABASE_URL=postgresql://locfly:locfly@localhost:5432/locfly

# Auth
JWT_SECRET=your-secret-key-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Redis — used for cache and BullMQ queues (running via docker-compose)
REDIS_URL=redis://localhost:6379

# Email (for price alerts) — choose one
# EMAIL_FROM=noreply@locfly.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password

# Sentry (optional — leave empty in development)
SENTRY_DSN=
